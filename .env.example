# Postgres connection string. In Supabase: Project > Connect > "Transaction pooler" (port 6543).
# Leave empty to store games in ./data/matches.json while trying the site locally.
DATABASE_URL=

# Any long random string. The collector sends it so only your group can add games.
INGEST_KEY=

# Optional. If set, the site asks for this password before showing anything.
SITE_PASSWORD=

# Optional. Name shown in the header.
NEXT_PUBLIC_GROUP_NAME=custy.gg

# Optional. Time zone for dates and the weekly recap. Defaults to America/New_York.
NEXT_PUBLIC_TIMEZONE=

# Optional. Riot API key (developer.riotgames.com). The game review asks the site for item purchases
# and skill-ups the League client leaves out of ranked games; the site fetches them with this key.
RIOT_API_KEY=

# Optional. If set, /api/agent needs "Authorization: Bearer <key>".
AGENT_API_KEY=

# Optional. Discord bot (see the site's /discord page).
DISCORD_APP_ID=
DISCORD_PUBLIC_KEY=

# Optional. If set, /api/cron/weekly only runs for requests carrying it (Vercel sends it automatically).
CRON_SECRET=
